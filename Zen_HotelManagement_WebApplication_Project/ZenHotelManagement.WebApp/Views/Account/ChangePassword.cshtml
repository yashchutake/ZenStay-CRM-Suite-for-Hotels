@model ChangePassword
@{
    ViewData["Title"] = "Change Password";
}

<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-md-5">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-lock text-primary" style="font-size: 3rem;"></i>
                        <h2 class="mt-3">Change Password</h2>
                        <p class="text-muted">Please enter your current and new password.</p>
                    </div>

                    @if (ViewData.ModelState.ErrorCount > 0)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Error!</strong> @Html.ValidationSummary(true)
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-action="ChangePassword" asp-controller="Account" method="post">
                        <div class="form-floating mb-3">
                            <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Current Password" />
                            <label asp-for="CurrentPassword"><i class="bi bi-key me-2"></i>Current Password</label>
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="New Password" />
                            <label asp-for="NewPassword"><i class="bi bi-lock me-2"></i>New Password</label>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
                            <label asp-for="ConfirmPassword"><i class="bi bi-lock me-2"></i>Confirm Password</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right me-2"></i>Change Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
