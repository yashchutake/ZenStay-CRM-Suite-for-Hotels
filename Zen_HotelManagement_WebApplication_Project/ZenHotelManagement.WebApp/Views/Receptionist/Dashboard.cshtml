@{
    ViewData["ActiveTab"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/receptionist/dashboard.css" />
}

<div class="receptionist-dashboard">
    <h2 class="page-title">Receptionist Dashboard</h2>

    <div class="dashboard-container">
        <!-- Stats Cards Section -->
        <div class="stats-section">
            <div class="row g-2">
                <div class="col-12 col-md-4">
                    <div class="card stats-card text-white shadow-sm" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="stats-label">Available Rooms</p>
                                    <h2 class="stats-value mb-0">@ViewData["AvailableRooms"]</h2>
                                </div>
                                <div class="stats-icon">
                                    <i class="fas fa-bed"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card stats-card text-white shadow-sm" style="background: linear-gradient(135deg, #6366f1, #4f46e5);">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="stats-label">Checked-In Customers</p>
                                    <h2 class="stats-value mb-0">@ViewData["CheckedInCustomers"]</h2>
                                </div>
                                <div class="stats-icon">
                                    <i class="fas fa-users"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card stats-card text-white shadow-sm" style="background: linear-gradient(135deg, #06b6d4, #0891b2);">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <p class="stats-label">Available Cab Drivers</p>
                                    <h2 class="stats-value mb-0">@ViewData["AvailableCabDrivers"]</h2>
                                </div>
                                <div class="stats-icon">
                                    <i class="fas fa-car"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>        </div>

        <!-- Dashboard Widgets Section -->
        <div class="widgets-row">
            <!-- Left Column: Quick Actions -->
            <div class="left-column">
                <!-- Quick Actions Widget -->
                <div class="widget-card quick-actions-widget">
                    <div class="widget-header">
                        <h4 class="widget-title">Quick Actions</h4>
                    </div>
                    <div class="widget-body">
                        <div class="quick-actions-buttons">
                            <a href="/Customer/Create" class="action-btn primary">
                                <i class="fas fa-user-plus"></i>
                                Add Customer
                            </a>                            <a href="/Customer/Index" class="action-btn secondary">
                                <i class="fas fa-search"></i>
                                Find Customer
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Today's Arrivals Widget -->
                <div class="widget-card arrivals-widget">
                    <div class="widget-header">
                        <h4 class="widget-title">Today's Arrivals</h4>
                    </div>
                    <div class="widget-body">
                        <div class="table-container">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>Customer</th>
                                        <th>Room</th>
                                        <th>Time</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var todayArrivals = ((List<ZenHotelManagement.WebApp.Services.TodayArrival>)ViewData["TodayArrivals"]).Take(5);
                                    }
                                    @foreach (var arrival in todayArrivals)
                                    {
                                        <tr>
                                            <td>@arrival.CustomerName</td>
                                            <td>@arrival.RoomNo</td>
                                            <td>@arrival.CheckInTime</td>
                                            <td>
                                                <span class="badge @(arrival.BookingStatus == "Confirmed" ? "bg-success" : arrival.BookingStatus == "Checked-In" ? "bg-primary" : "bg-warning")">
                                                    @arrival.BookingStatus
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                    @if (!todayArrivals.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">No arrivals scheduled for today</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="widget-footer">
                        <a href="/Customer/Index" class="btn btn-link text-primary">
                            <i class="fas fa-external-link-alt"></i>
                            View All Customers
                        </a>
                    </div>
                </div>
            </div><!-- Right Column: Daily Check-ins Chart -->
            <div class="right-column">
                <div class="widget-card chart-widget">
                    <div class="widget-header">
                        <h4 class="widget-title">Daily Check-ins (Last 5 Days)</h4>
                    </div>
                    <div class="widget-body">
                        <div class="chart-container">
                            <canvas id="dailyCheckInsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<script>
    // Daily Check-ins Chart
    const dailyCheckInsData = @Html.Raw(ViewData["DailyCheckInsData"]);
    
    // Chart colors - modern blue gradient
    const barColor = '#6366f1';
    const barHoverColor = '#4f46e5';
    
    const labels = Object.keys(dailyCheckInsData);
    const values = Object.values(dailyCheckInsData);
    
    const chartInstance = new Chart(document.getElementById('dailyCheckInsChart'), {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Check-ins',
                data: values,
                backgroundColor: barColor,
                borderColor: barColor,
                borderWidth: 1,
                borderRadius: 6,
                borderSkipped: false,
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                title: {
                    display: false
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1,
                        font: {
                            size: 11
                        },
                        color: '#6b7280'
                    },
                    grid: {
                        color: '#f3f4f6',
                        drawBorder: false
                    }
                },
                x: {
                    ticks: {
                        font: {
                            size: 11
                        },
                        color: '#6b7280'
                    },
                    grid: {
                        display: false
                    }
                }
            },
            onHover: function(event, activeElements) {
                event.native.target.style.cursor = activeElements.length > 0 ? 'pointer' : 'default';
            },
            interaction: {
                intersect: false,
                mode: 'index'
            },
            animation: {
                duration: 800,
                easing: 'easeInOutQuart'
            }
        }
    });
    
    // Add hover effect to bars
    chartInstance.options.onHover = function(event, activeElements) {
        if (activeElements.length > 0) {
            event.native.target.style.cursor = 'pointer';
            // Change color on hover
            chartInstance.data.datasets[0].backgroundColor = values.map((_, index) => 
                activeElements[0].index === index ? barHoverColor : barColor
            );
            chartInstance.update('none');
        } else {
            event.native.target.style.cursor = 'default';
            chartInstance.data.datasets[0].backgroundColor = barColor;
            chartInstance.update('none');
        }
    };
</script>