@model ZenHotelManagement.WebApp.Models.Employee

@{
    ViewData["ActiveTab"] = "Employees";
}

<div class="card shadow-sm animate__animated animate__fadeIn">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0">
            <i class="bi bi-person-gear me-2"></i>Edit Employee Details
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post" id="editForm" class="mt-3 needs-validation" novalidate>
            <input type="hidden" asp-for="EmployeeId" />
            <input type="hidden" asp-for="IsDeleted" />                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="Name" class="form-control" placeholder="Enter name" required />
                            <label asp-for="Name">Employee Name</label>
                            <span asp-validation-for="Name" class="text-danger"></span>
                            <div class="invalid-feedback">Please provide a name.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="Age" class="form-control" placeholder="Enter age" required type="number" min="18" max="65" />
                            <label asp-for="Age">Employee Age</label>
                            <span asp-validation-for="Age" class="text-danger"></span>
                            <div class="invalid-feedback">Please provide a valid age between 18 and 65.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="mb-3">
                            <label class="form-label d-block">Gender</label>
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" asp-for="Gender" value="Male" id="genderMale" required>
                                <label class="btn btn-outline-primary" for="genderMale">
                                    <i class="bi bi-gender-male me-2"></i>Male
                                </label>

                                <input type="radio" class="btn-check" asp-for="Gender" value="Female" id="genderFemale" required>
                                <label class="btn btn-outline-primary" for="genderFemale">
                                    <i class="bi bi-gender-female me-2"></i>Female
                                </label>

                                <input type="radio" class="btn-check" asp-for="Gender" value="Other" id="genderOther" required>
                                <label class="btn btn-outline-primary" for="genderOther">
                                    <i class="bi bi-person me-2"></i>Other
                                </label>
                            </div>
                            <span asp-validation-for="Gender" class="text-danger d-block mt-2"></span>
                            <div class="invalid-feedback">Please select a gender.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <select asp-for="Position" class="form-select" required>
                                <option value="">Select Position</option>
                                @foreach (var position in (ViewBag.Positions as List<string> ?? new List<string>()))
                                {
                                    <option value="@position">@position</option>
                                }
                            </select>
                            <label asp-for="Position">Position</label>
                            <span asp-validation-for="Position" class="text-danger"></span>
                            <div class="invalid-feedback">Please select a position.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="Salary" class="form-control" placeholder="Enter salary" required type="number" step="0.01" min="0" />
                            <label asp-for="Salary">Monthly Salary</label>
                            <span asp-validation-for="Salary" class="text-danger"></span>
                            <div class="invalid-feedback">Please provide a valid salary amount.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <div class="input-group">
                                <select class="form-select" style="max-width: 150px;" id="countryCode" name="countryCode">
                                    <option value="+91">India (+91)</option>
                                    <option value="+1">USA (+1)</option>
                                    <option value="+44">UK (+44)</option>
                                    <option value="+81">Japan (+81)</option>
                                    <option value="+86">China (+86)</option>
                                </select>
                                <input asp-for="MobileNo" class="form-control" type="tel" placeholder="Enter mobile number"
                                       required maxlength="10" pattern="\d{10}" 
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 10)" />
                                
                            </div>
                            <span asp-validation-for="MobileNo" class="text-danger"></span>
                            <div class="invalid-feedback">Please provide a valid 10-digit mobile number.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="AdharNo" class="form-control" placeholder="Enter Aadhar number" 
                                   required maxlength="12" pattern="\d{12}"
                                   oninput="this.value = this.value.replace(/[^0-9]/g, '').slice(0, 12)" />
                            <label asp-for="AdharNo">Aadhar Number</label>
                            <span asp-validation-for="AdharNo" class="text-danger"></span>
                            <div class="invalid-feedback">Please provide a valid 12-digit Aadhar number.</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="Enter email" required type="email" />
                            <label asp-for="Email">Email Address</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                            <div class="invalid-feedback">Please provide a valid email address.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Enable Bootstrap validation styling
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()

        // Handle form submission with validation and confirmation
        document.querySelector('#editForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            if (!this.checkValidity()) {
                return;
            }

            const mobileInput = document.querySelector('#MobileNo');
            const adharInput = document.querySelector('#AdharNo');
            const salaryInput = document.querySelector('#Salary');

            // Validation checks
            if (mobileInput.value.length !== 10) {
                await Swal.fire({
                    icon: 'error',
                    title: 'Invalid Mobile Number',
                    text: 'Mobile number must be exactly 10 digits!',
                    confirmButtonColor: '#d33'
                });
                return;
            }

            if (adharInput.value.length !== 12) {
                await Swal.fire({
                    icon: 'error',
                    title: 'Invalid Aadhar Number',
                    text: 'Aadhar number must be exactly 12 digits!',
                    confirmButtonColor: '#d33'
                });
                return;
            }

            if (parseFloat(salaryInput.value) < 0) {
                await Swal.fire({
                    icon: 'error',
                    title: 'Invalid Salary',
                    text: 'Salary cannot be negative!',
                    confirmButtonColor: '#d33'
                });
                return;
            }

            // Confirmation dialog
            const result = await Swal.fire({
                title: 'Save Changes?',
                text: 'Are you sure you want to update this employee\'s information?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, save changes',
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'animate__animated animate__fadeInDown'
                }
            });

            if (result.isConfirmed) {
                // Show loading state
                Swal.fire({
                    title: 'Saving...',
                    html: 'Please wait while we update the employee information.',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    willOpen: () => {
                        Swal.showLoading();
                    }
                });

                // Submit the form
                this.submit();
            }
        });
    </script>

