@model CabDriver

@{
    ViewData["ActiveTab"] = "CabDrivers";
}

<div class="card shadow-sm animate__animated animate__fadeIn">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0">
            <i class="bi bi-person-plus-fill me-2"></i>Add New Cab Driver
        </h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="mt-3 needs-validation" novalidate>           
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Name" class="form-control" placeholder="Enter name" required />
                        <label asp-for="Name">Driver Name</label>
                        <span asp-validation-for="Name" class="text-danger"></span>
                        <div class="invalid-feedback">Please provide a name.</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Age" class="form-control" placeholder="Enter age" required min="18" max="65" />
                        <label asp-for="Age">Driver Age</label>
                        <span asp-validation-for="Age" class="text-danger"></span>
                        <div class="invalid-feedback">Please provide a valid age between 18 and 65.</div>
                    </div>
                </div>                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label d-block">Gender</label>
                        <div class="btn-group" role="group">
                            <input type="radio" class="btn-check" name="Gender" value="Male" id="genderMale" autocomplete="off" required>
                            <label class="btn btn-outline-primary" for="genderMale">
                                <i class="bi bi-gender-male me-2"></i>Male
                            </label>

                            <input type="radio" class="btn-check" name="Gender" value="Female" id="genderFemale" autocomplete="off" required>
                            <label class="btn btn-outline-primary" for="genderFemale">
                                <i class="bi bi-gender-female me-2"></i>Female
                            </label>

                            <input type="radio" class="btn-check" name="Gender" value="Other" id="genderOther" autocomplete="off" required>
                            <label class="btn btn-outline-primary" for="genderOther">
                                <i class="bi bi-person me-2"></i>Other
                            </label>
                        </div>
                        <span asp-validation-for="Gender" class="text-danger d-block mt-2"></span>
                        <div class="invalid-feedback">Please select a gender.</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="CarVendor" class="form-control" placeholder="Enter car vendor" required />
                        <label asp-for="CarVendor">Car Vendor</label>
                        <span asp-validation-for="CarVendor" class="text-danger"></span>
                        <div class="invalid-feedback">Please provide the car vendor.</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="CarType" class="form-control" placeholder="Enter car type" required />
                        <label asp-for="CarType">Car Type</label>
                        <span asp-validation-for="CarType" class="text-danger"></span>
                        <div class="invalid-feedback">Please provide the car type.</div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-2"></i>Create Driver
                </button>
            </div>
        </form>
    </div>
</div>

    <script>
        // Enable Bootstrap validation styling
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms).forEach(function (form) {
                form.addEventListener('submit', function (event) {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>

