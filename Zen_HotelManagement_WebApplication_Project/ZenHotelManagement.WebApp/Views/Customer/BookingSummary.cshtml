@model ZenHotelManagement.WebApp.Models.ViewModel.BookingSummaryViewModel

@{
	ViewData["ActiveTab"] = "Customers";
}

<script src="~/js/notification.js"></script>


<!-- Header Section -->
<div class="d-flex justify-content-between align-items-center mb-4">
	<div class="d-flex align-items-center">
		<div class="avatar-lg bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3">
			<i class="bi bi-check-circle-fill text-success fs-4"></i>
		</div>
		<div>
			<h2 class="mb-0">Booking Summary</h2>
			<small class="text-muted">Customer and booking details successfully created</small>
		</div>
	</div>
	<div class="d-flex gap-2">
		<a href="@Url.Action("Details", "Customer", new { customerId = Model.CustomerId })" class="btn btn-outline-primary">
			<i class="bi bi-eye me-2"></i>
			View Customer Details
		</a>
		<a href="@Url.Action("Create", "Customer")" class="btn btn-primary">
			<i class="bi bi-person-plus me-2"></i>
			Add Another Customer
		</a>
	</div>
</div>

<!-- Success Alert -->
@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show border-0 shadow-sm" role="alert">
		<i class="bi bi-check-circle-fill me-2"></i>
		@TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<!-- Customer Information Card -->
<div class="card shadow-sm mb-4">
	<div class="card-header border-0 bg-white">
		<h5 class="mb-0 text-muted">
			<i class="bi bi-person-fill me-2"></i>Customer Information
		</h5>
	</div>
	<div class="card-body">		<div class="row g-3">
			<div class="col-md-4">
				<div class="info-item">
					<label class="text-muted small">Customer ID</label>
					<p class="mb-0 fw-medium">@Model.CustomerId</p>
				</div>
			</div>
			<div class="col-md-4">
				<div class="info-item">
					<label class="text-muted small">Name</label>
					<p class="mb-0 fw-medium">@Model.CustomerName</p>
				</div>
			</div>
			<div class="col-md-4">
				<div class="info-item">
					<label class="text-muted small">Mobile</label>
					<p class="mb-0 fw-medium">@Model.MobileNo</p>
				</div>
			</div>	</div>
</div>

<!-- Room Bookings Summary -->
<div class="card shadow-sm mb-4">
	<div class="card-header border-0 bg-white">
		<h5 class="mb-0 text-muted">
			<i class="bi bi-house-door-fill me-2"></i>
			Room Bookings Summary (@Model.RoomBookings.Count Rooms)
		</h5>
	</div>
				<div class="card-body">
					@if (Model.RoomBookings.Any())
					{
						<div class="table-responsive">
							<table class="table table-hover">
								<thead class="table-light">
									<tr>
										<th>Room</th>
										<th>Nights</th>
										<th>Check-in</th>
										<th>Check-out</th>
										<th>Guests</th>
										<th>Total Amount</th>
										<th>Advance Payment</th>
										<th>Amount at Checkout</th>
									</tr>
								</thead>
								<tbody>
									@foreach (var booking in Model.RoomBookings)
									{
										<tr>
											<td>
												<strong>@booking.RoomNo</strong>
											</td>
											<td>
												@if (booking.CheckOutDate.HasValue)
												{
													<span class="badge bg-info">@booking.NumberOfNights night@(booking.NumberOfNights != 1 ? "s" : "")</span>
												}
												else
												{
													<span class="badge bg-secondary" title="Tentative costing based on 1 night">1 night (TBD)</span>
												}
											</td>
											<td>@booking.CheckInDate.ToString("MMM dd, yyyy HH:mm")</td>
											<td>
												@if (booking.CheckOutDate.HasValue)
												{
													@booking.CheckOutDate.Value.ToString("MMM dd, yyyy HH:mm")
												}
												else
												{
													<span class="text-muted">TBD</span>
												}
											</td>
											<td>@booking.NumberOfGuests</td>                                            <td>											@if (booking.CheckOutDate.HasValue)
												{
													<span>₹@(booking.Amount.ToString("N2"))</span>
												}
												else
												{
													<span title="Tentative costing - final amount will be calculated when checkout date is confirmed">
														₹@(booking.Amount.ToString("N2")) <small class="text-muted">(tentative)</small>
													</span>
												}
											</td>
											<td>₹@(booking.AmountPaid.ToString("N2"))</td>
											<td>
												@if (booking.CheckOutDate.HasValue)
												{
													<span class="text-success">₹@((booking.Amount - booking.AmountPaid).ToString("N2"))</span>
												}
												else
												{
													<span class="text-success" title="Final amount will be calculated when checkout date is confirmed">
														₹@((booking.Amount - booking.AmountPaid).ToString("N2")) <small class="text-muted">(tentative)</small>
													</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>						<!-- Room Booking Totals -->
						<div class="row mt-4">
							<div class="col-md-8"></div>
							<div class="col-md-4">
								<div class="card bg-light border-0">
									<div class="card-body">
										<h6 class="card-title text-muted">Room Booking Summary</h6>										<div class="d-flex justify-content-between mb-2">
											<span class="text-muted">Total Room Amount:</span>
											<strong>₹@(Model.TotalRoomAmount.ToString("N2"))</strong>
										</div>
										<div class="d-flex justify-content-between mb-2">
											<span class="text-muted">Advance Payment (Rooms):</span>
											<strong class="text-success">₹@(Model.TotalAmountPaid.ToString("N2"))</strong>
										</div>
										<div class="d-flex justify-content-between">
											<span class="text-muted">Amount at Checkout (Rooms):</span>
											<strong class="text-success">₹@((Model.TotalRoomAmount - Model.TotalAmountPaid).ToString("N2"))</strong>
										</div>
									</div>
								</div>
							</div>
						</div>
					}
					else
					{
						<div class="text-center text-muted py-4">
							<i class="bi bi-house display-4"></i>
							<p class="mt-2">No room bookings found.</p>
						</div>
					}
				</div>
			</div>			<!-- Cab Booking Summary -->
			@if (Model.IncludeCabBooking && Model.CabBooking != null)
			{
				<div class="card shadow-sm mb-4">
					<div class="card-header border-0 bg-white">
						<h5 class="mb-0 text-muted">
							<i class="bi bi-car-front-fill me-2"></i>
							Cab Booking Summary
						</h5>
					</div>					<div class="card-body">
						<div class="row g-3">
							<div class="col-md-6">
								<div class="info-item">
									<label class="text-muted small">Driver ID</label>
									<p class="mb-0 fw-medium">@Model.CabBooking.CabDriverId</p>
								</div>
								<div class="info-item">
									<label class="text-muted small">Pick-up Location</label>
									<p class="mb-0 fw-medium">@Model.CabBooking.PickUpLocation</p>
								</div>
								<div class="info-item">
									<label class="text-muted small">Drop-off Location</label>
									<p class="mb-0 fw-medium">@Model.CabBooking.DropOffLocation</p>
								</div>
							</div>
							<div class="col-md-6">
								<div class="info-item">
									<label class="text-muted small">Pick-up Time</label>
									<p class="mb-0 fw-medium">@Model.CabBooking.PickUpDateTime.ToString("MMM dd, yyyy HH:mm")</p>
								</div>
								<div class="info-item">
									<label class="text-muted small">Drop-off Time</label>
									<p class="mb-0 fw-medium">@Model.CabBooking.DropOffDateTime.ToString("MMM dd, yyyy HH:mm")</p>
								</div>								<div class="info-item">
									<label class="text-muted small">Cab Fare</label>
									<p class="mb-0 fw-medium text-success">₹@(Model.CabBooking.Fare.ToString("N2"))</p>
								</div>
							</div>
						</div>
					</div>
				</div>			}
			
			<!-- Grand Total Summary -->
			<div class="card shadow-sm mb-4">
				<div class="card-header border-0 bg-white">
					<h5 class="mb-0 text-muted">
						<i class="bi bi-receipt me-2"></i>
						Grand Total Summary
						@if (Model.HasTentativeBookings)
						{
							<span class="badge bg-warning text-dark ms-2">Tentative</span>
						}
					</h5>
				</div>
				<div class="card-body">
					@if (Model.HasTentativeBookings)
					{
						<div class="alert alert-warning mb-3">
							<i class="bi bi-exclamation-triangle me-2"></i>
							<strong>Note:</strong> Some room bookings have unspecified checkout dates (TBD). The final total is tentative and will be recalculated when checkout dates are confirmed.
						</div>
					}
					<div class="row">
						<div class="col-md-8"></div>
						<div class="col-md-4">
							<div class="card bg-primary text-white">
								<div class="card-body">
									<h6 class="card-title text-white">Final Summary @(Model.HasTentativeBookings ? "(Tentative)" : "")</h6>									<div class="d-flex justify-content-between mb-2">
										<span>Room Amount:</span>
										<strong>₹@(Model.TotalRoomAmount.ToString("N2"))</strong>
									</div>
									@if (Model.IncludeCabBooking && Model.CabBooking != null)
									{
										<div class="d-flex justify-content-between mb-2">
											<span>Cab Fare:</span>
											<strong>₹@(Model.CabBooking.Fare.ToString("N2"))</strong>
										</div>
										<hr class="bg-white">
										<div class="d-flex justify-content-between mb-2">
											<span><strong>Grand Total:</strong></span>
											<strong>₹@(Model.GrandTotal.ToString("N2"))</strong>
										</div>                                        <div class="d-flex justify-content-between mb-2">
											<span>Total Advance Payment:</span>
											<strong>₹@(Model.TotalAmountPaid.ToString("N2"))</strong>
										</div>
										<div class="d-flex justify-content-between">
											<span>Amount at Checkout:</span>
											<strong>₹@((Model.GrandTotal - Model.TotalAmountPaid).ToString("N2"))</strong>
										</div>
									}
									else
									{
																				<div class="d-flex justify-content-between mb-2">
											<span>Total Paid:</span>
											<strong>₹@(Model.TotalAmountPaid.ToString("N2"))</strong>
										</div>
										<div class="d-flex justify-content-between">
											<span>Amount at Checkout:</span>
											<strong>₹@((Model.TotalRoomAmount - Model.TotalAmountPaid).ToString("N2"))</strong>
										</div>
									}
								</div>
							</div>
						</div>
					</div>
				</div>
			</div><!-- Action Buttons -->
			<div class="row">
				<div class="col-12 text-center">
					@if (TempData.Peek("PendingCustomerModel") != null)
					{
						<!-- This is a pending booking that needs confirmation -->
						<form asp-action="ConfirmBooking" method="post" class="d-inline me-3">
							@Html.AntiForgeryToken()
							<button type="submit" class="btn btn-success btn-lg me-3">
								<i class="bi bi-check-circle me-2"></i>
								Confirm Booking
							</button>
						</form>						<a href="@Url.Action("Create", "Customer", new { fromSummary = true })" class="btn btn-outline-secondary btn-lg">
							<i class="bi bi-arrow-left me-2"></i>
							Back to Edit
						</a>
					}
					else
					{
						<!-- This is a confirmed booking -->
						<a href="@Url.Action("Index", "Customer")" class="btn btn-outline-secondary btn-lg me-3">
							<i class="bi bi-list me-2"></i>
							View All Customers
						</a>
						<a href="@Url.Action("Create", "Customer")" class="btn btn-primary btn-lg">
							<i class="bi bi-person-plus me-2"></i>
							Add Another Customer
						</a>
					}
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.info-item {
		margin-bottom: 1rem;
	}

	.info-item label {
		display: block;
		font-size: 0.875rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin-bottom: 0.25rem;
	}

	.info-item p {
		font-size: 1rem;
		color: #495057;
	}

	.card {
		border: none;
		border-radius: 12px;
	}

	.card-header {
		background: transparent !important;
		border-bottom: 1px solid #e9ecef;
		border-radius: 12px 12px 0 0 !important;
	}

	.table th {
		border-top: none;
		font-weight: 600;
		color: #6c757d;
		text-transform: uppercase;
		font-size: 0.875rem;
		letter-spacing: 0.5px;
	}

	.table td {
		vertical-align: middle;
		border-color: #f8f9fa;
	}

	.badge {
		font-weight: 500;
	}

	.avatar-lg {
		width: 4rem;
		height: 4rem;
	}

	.btn-lg {
		padding: 0.75rem 2rem;
		font-weight: 500;
	}

	.alert {
		border: none;
		border-radius: 10px;
	}
</style>

<script>	// Auto-hide only dismissible alerts (temporary notifications) after 5 seconds
	setTimeout(function() {
		const dismissibleAlerts = document.querySelectorAll('.alert.alert-dismissible');
		dismissibleAlerts.forEach(function(alert) {
			// Only hide if it's a success or info alert (not error/warning which should stay visible)
			if (alert.classList.contains('alert-success') || alert.classList.contains('alert-info')) {
				alert.style.transition = 'opacity 0.5s ease';
				alert.style.opacity = '0';
				setTimeout(function() {
					if (alert.parentNode) {
						alert.remove();
					}
				}, 500);
			}
		});
	}, 5000);
</script>
