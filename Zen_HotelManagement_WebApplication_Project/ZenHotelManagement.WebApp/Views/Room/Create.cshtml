@model ZenHotelManagement.WebApp.Models.Room

@{
    ViewData["ActiveTab"] = "Rooms";
}

<script src="~/js/notification.js"></script>

<!-- Header Section -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="avatar-lg bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-3">
            <i class="bi bi-door-open-fill text-primary fs-4"></i>
        </div>
        <div>
            <h2 class="mb-0">Add New Room</h2>
            <small class="text-muted">Create a new room in the hotel</small>
        </div>
    </div>
    @* <a href="@Url.Action("Index", "Room")" class="btn btn-outline-secondary"> *@
    @*     <i class="bi bi-arrow-left me-2"></i> *@
    @*     Back *@
    @* </a> *@
</div>

<!-- Alerts Section -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Create" method="post" class="needs-validation" novalidate>    @Html.AntiForgeryToken()
    
    <!-- Room Details Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header border-0 bg-white">
            <h5 class="mb-0 text-muted">
                <i class="bi bi-door-open me-2"></i>Room Details
            </h5>
            <small class="text-muted">Basic room information and amenities</small>
        </div>
        <div class="card-body">
            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="RoomNo" class="form-control" placeholder="Room Number" required />
                        <label asp-for="RoomNo">Room Number <span class="text-danger">*</span></label>
                        <span asp-validation-for="RoomNo" class="text-danger small"></span>
                        <div class="form-text">Enter a unique room number (e.g., A-101, B-205)</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="RoomType" class="form-select" required>
                            <option value="">Select Room Type</option>
                            <option value="Single Bed">Single Bed</option>
                            <option value="Double Bed">Double Bed</option>
                            <option value="Semi Deluxe">Semi Deluxe</option>
                            <option value="Deluxe">Deluxe</option>
                        </select>
                        <label asp-for="RoomType">Room Type <span class="text-danger">*</span></label>
                        <span asp-validation-for="RoomType" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="CostPerNight" class="form-control" type="number" step="0.01" min="100" max="50000" placeholder="Cost per night" required />
                        <label asp-for="CostPerNight">Cost per Night (₹) <span class="text-danger">*</span></label>
                        <span asp-validation-for="CostPerNight" class="text-danger small"></span>
                        <div class="form-text">Amount between ₹100 - ₹50,000</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="RoomCapacity" class="form-select" required>
                            <option value="">Select Capacity</option>
                            <option value="1">1 Guest</option>
                            <option value="2">2 Guests</option>
                            <option value="3">3 Guests</option>
                            <option value="4">4 Guests</option>
                            <option value="5">5 Guests</option>
                            <option value="6">6 Guests</option>
                            <option value="8">8 Guests</option>
                            <option value="10">10 Guests</option>
                        </select>
                        <label asp-for="RoomCapacity">Room Capacity <span class="text-danger">*</span></label>
                        <span asp-validation-for="RoomCapacity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="col-12">
                    <label class="form-label">Air Conditioning <span class="text-danger">*</span></label>
                    <div class="form-check-container mt-2">
                        <div class="form-check form-check-inline">
                            <input asp-for="IsAc" class="form-check-input" type="radio" value="true" id="ac-yes" required>
                            <label class="form-check-label" for="ac-yes">
                                <i class="bi bi-snow2 me-1"></i>AC
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input asp-for="IsAc" class="form-check-input" type="radio" value="false" id="ac-no" required>
                            <label class="form-check-label" for="ac-no">
                                <i class="bi bi-fan me-1"></i>Non-AC
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="IsAc" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Submit Button -->
    <div class="d-flex justify-content-end gap-2 mt-4">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle me-2"></i>Create Room
        </button>
    </div>
</form>

<!-- Room Exists Modal -->
<div class="modal fade" id="roomExistsModal" tabindex="-1" aria-labelledby="roomExistsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="roomExistsModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Room Already Exists
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="mb-0" id="roomExistsMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
<script>
    // Bootstrap form validation
    (function() {
        'use strict';
        window.addEventListener('load', function() {
            var forms = document.getElementsByClassName('needs-validation');
            var validation = Array.prototype.filter.call(forms, function(form) {
                form.addEventListener('submit', function(event) {
                    if (form.checkValidity() === false) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        }, false);
    })();

    // Format currency input only on blur
    document.addEventListener('DOMContentLoaded', function() {
        const costInput = document.querySelector('input[name="CostPerNight"]');
        if (costInput) {
            costInput.addEventListener('blur', function(e) {
                let value = e.target.value;
                if (value && !isNaN(value)) {
                    e.target.value = parseFloat(value).toFixed(2);
                }
            });
        }
    });

    // Auto-hide success alerts after 5 seconds
    setTimeout(function() {
        const dismissibleAlerts = document.querySelectorAll('.alert.alert-dismissible');
        dismissibleAlerts.forEach(function(alert) {
            if (alert.classList.contains('alert-success') || alert.classList.contains('alert-info')) {
                alert.style.transition = 'opacity 0.5s ease';
                alert.style.opacity = '0';
                setTimeout(function() {
                    if (alert.parentNode) {
                        alert.remove();
                    }
                }, 500);
            }
        });
    }, 5000);

    // Check for room exists error and show modal
    document.addEventListener('DOMContentLoaded', function() {
        const roomExistsError = '@TempData["RoomExistsError"]';
        if (roomExistsError) {
            const modal = new bootstrap.Modal(document.getElementById('roomExistsModal'));
            document.getElementById('roomExistsMessage').textContent = roomExistsError;
            modal.show();
        }
    });
</script>


<style>
.avatar-lg {
    width: 60px;
    height: 60px;
}

.card {
    border: none;
    border-radius: 0.75rem;
}

.card-header {
    background: transparent !important;
    border-bottom: 1px solid #f1f3f4;
}

.form-floating > label {
    font-weight: 500;
}

.form-floating > .form-control:focus,
.form-floating > .form-select:focus {
    border-color: #86b7fe;
    box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
}

.btn {
    border-radius: 0.5rem;
    font-weight: 500;
}

.alert {
    border-radius: 0.75rem;
    border: none;
}

.form-check-container {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.5rem;
}

.form-check-inline {
    margin-right: 0;
}

.form-text {
    font-size: 0.8rem;
    color: #6c757d;
}
</style>



